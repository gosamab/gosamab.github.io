---
interface Props {
	title: string;
	description: string;
	href: string;
	imageUrl?: string;
	tags?: string[];
}

const {
	title,
	description,
	href,
	imageUrl,
	tags = [],
} = Astro.props;
---

<a
	href={href}
	class="group block bg-white border border-stone-200 hover:border-stone-400 transition rounded-lg overflow-hidden flex flex-col"
>
	{
		imageUrl && (
			<div class="aspect-[16/10] bg-stone-100 overflow-hidden">
				<img
					src={imageUrl}
					alt={title}
					class="w-full h-full object-cover group-hover:scale-[1.02] transition duration-500"
					loading="lazy"
				/>
			</div>
		)
	}
	<div class="p-5 flex-1 flex flex-col">
		<h3
			class="font-serif text-lg font-semibold text-stone-900 group-hover:text-amber-700 transition mb-2"
		>
			{title}
		</h3>
		<p class="text-sm text-stone-600 leading-relaxed flex-1">{description}</p>
		{
			tags.length > 0 && (
				<div class="flex flex-wrap gap-1.5 mt-4">
					{tags.map((tag) => (
						<span class="font-mono text-[10px] uppercase tracking-wider text-stone-500 border border-stone-200 px-2 py-0.5 rounded-full">
							{tag}
						</span>
					))}
				</div>
			)
		}
	</div>
</a>
