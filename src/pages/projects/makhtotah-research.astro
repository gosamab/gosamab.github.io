	tagline:
		"Improving OCR accuracy on Arabic historical manuscripts using deep learning and classical binarization techniques.",
	description:
		"Senior graduation project at Prince Sultan University on Arabic manuscript OCR.",
	status: "ongoing" as const,
	startDate: "Aug 2024",
	endDate: "Dec 2025",
	type: "research" as const,
	role: "Researcher, lead implementer",
	team: "Solo (advised by faculty)",
	stack: [
		"Python",
		"PyTorch",
		"TensorFlow",
		"OpenCV",
		"scikit-image",
		"MongoDB",
	],
	links: {
		repo: "https://github.com/gosamab/makhtotah-research",
	},
	highlights: [
		{ value: "−30%", label: "CER vs commercial baselines" },
		{ value: "4", label: "binarization methods compared" },
		{ value: "3", label: "model architectures evaluated" },
	],
	toc: [
		{ id: "why-it-exists", label: "Why it exists" },
		{ id: "what-i-built", label: "What I built" },
		{ id: "methodology", label: "Methodology" },
		{ id: "evaluation", label: "Evaluation" },
		{ id: "hard-parts", label: "Hard parts" },
		{ id: "results", label: "Results" },
