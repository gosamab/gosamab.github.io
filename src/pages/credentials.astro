---
import BaseLayout from "../layouts/BaseLayout.astro";
import WindowChrome from "../layouts/WindowChrome.astro";

type Credential = {
	name: string;
	year: string;
	issuer?: string;
	url?: string;
};

const awards: Credential[] = [
	{
		name: "ACM Programming Jam X: 1st place, national (Saudi Arabia)",
		year: "2025",
	},
	{
		name: "Dean's certificate of appreciation, representing CCIS in competitions",
		issuer: "Dr. Mohammed Alshara, Dean of CCIS, Prince Sultan University",
		year: "2025",
	},
	{
		name: "B.Sc. Computer Science, first honors",
		issuer: "Prince Sultan University",
		year: "2025",
	},
	{
		name: "IEEE Xtreme 18.0: 6th in KSA, 271st globally (team: TheCodefather)",
		year: "2024",
	},
	{ name: "ACM Programming Jam 9: 5th place", year: "2024" },
	{ name: "ACM Programming Jam 8: 18th place", year: "2023" },
	{ name: "ACM Programming Jam 7: 13th place", year: "2022" },
];

const certifications: Credential[] = [
	{
		name: "CS50 AI",
		issuer: "HarvardX",
		year: "2025",
		url: "https://courses.edx.org/certificates/5f49ad8864e34ac7a1ffde57b331e2be",
	},
	{
		name: "CS50x",
		issuer: "HarvardX",
		year: "2025",
		url: "https://courses.edx.org/certificates/7761f1781b3746d98b63785c925598a6",
	},
	{
		name: "UI Certified Designer",
		issuer: "NMKKN نُمكّن",
		year: "2024",
	},
	{
		name: "CompTIA IT Fundamentals (ITF+)",
		issuer: "CompTIA",
		year: "2024",
		url: "https://www.credly.com/badges/d7f3dbda-96d8-4e3e-96ae-4efa09694844/linked_in_profile",
	},
	{
		name: "Oracle Database SQL Certified Associate",
		issuer: "Oracle",
		year: "2021",
		url: "https://www.youracclaim.com/badges/b3c9e270-1192-487b-9a6f-de6bb3151dde?source=linked_in_profile",
	},
	{
		name: "IELTS Academic: 6.5",
		issuer: "IELTS Official",
		year: "2021",
	},
];

---

<BaseLayout title="Credentials | Osama Azab">
	<WindowChrome filename="credentials.mdx" maxWidth="max-w-3xl">
		<section class="px-6 pt-16 pb-10">
			<p class="section-label mb-3">Credentials</p>
			<h1 class="text-4xl font-semibold mb-3">Awards and certifications.</h1>
			<p class="text-stone-600">
				Competition results and certifications.
			</p>
		</section>

		<section class="px-6 py-10 border-t border-stone-200">
			<h2 class="text-2xl font-semibold mb-6">Awards</h2>
			<ul class="space-y-3 text-stone-700">
				{
					awards.map((a) => (
						<li class="flex justify-between gap-6 border-b border-stone-200 pb-3">
							<span>
								{a.name}
								{a.issuer && (
									<span class="block text-xs text-stone-500 mt-1">
										{a.issuer}
									</span>
								)}
							</span>
							<span class="font-mono text-sm text-stone-500 shrink-0">
								{a.year}
							</span>
						</li>
					))
				}
			</ul>
		</section>

		<section class="px-6 py-10 border-t border-stone-200 pb-20">
			<h2 class="text-2xl font-semibold mb-6">Certifications</h2>
			<ul class="space-y-3 text-stone-700">
				{
					certifications.map((c) => (
						<li class="flex justify-between gap-6 border-b border-stone-200 pb-3">
							<span>
								{c.url ? (
									<a
										href={c.url}
										target="_blank"
										rel="noopener noreferrer"
										class="hover:text-amber-700 transition"
									>
										{c.name}
									</a>
								) : (
									c.name
								)}
								{c.issuer && (
									<span class="block text-xs text-stone-500 mt-1">
										{c.issuer}
									</span>
								)}
							</span>
							<span class="font-mono text-sm text-stone-500 shrink-0">
								{c.year}
							</span>
						</li>
					))
				}
			</ul>
		</section>
	</WindowChrome>
</BaseLayout>
