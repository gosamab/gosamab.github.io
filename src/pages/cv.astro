---
import BaseLayout from "../layouts/BaseLayout.astro";
import WindowChrome from "../layouts/WindowChrome.astro";
---

<BaseLayout title="CV | Osama Azab">
	<WindowChrome filename="cv.pdf" maxWidth="max-w-3xl">
		<div class="p-3 sm:p-6 flex flex-col gap-4">
			<img
				src="/cv.png"
				alt="Osama Azab CV"
				width="1241"
				height="1754"
				class="w-full h-auto border border-stone-200 shadow-sm bg-white"
			/>
			<a
				href="/CV.pdf"
				target="_blank"
				rel="noopener noreferrer"
				class="self-center text-sm hover:text-amber-700 transition"
				>Download PDF</a
			>
		</div>
	</WindowChrome>
</BaseLayout>
